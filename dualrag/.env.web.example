# Dedicated DualRAG Web/API configuration; copy to dualrag/.env.
# From the repository root, explicitly load it with:
# PYTHON_DOTENV_DISABLED=1 uv run --locked --extra web --env-file dualrag/.env lightrag-server ...
# The default configuration requires an Ollama server and the models below.
LLM_BINDING=ollama
LLM_BINDING_HOST=http://localhost:11434
LLM_MODEL=mistral-nemo:latest
LLM_BINDING_API_KEY=

EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://localhost:11434
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_DIM=1024
MAX_EMBED_TOKENS=8192
EMBEDDING_BINDING_API_KEY=

# Optional access key for the Web/API server itself, separate from model keys.
# LIGHTRAG_API_KEY=your-web-access-key
